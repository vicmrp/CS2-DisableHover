using Colossal;
using System.Collections.Generic;

namespace DisableHover.Settings
{
    /// <summary>
    /// Text shown in the mod settings UI.
    /// This file only controls labels/descriptions.
    /// It does not control the actual mod behavior.
    /// </summary>
    public class ModSettingsDefaultLocale : IDictionarySource
    {
        private Dictionary<string, string> Entries { get; set; }

        public ModSettingsDefaultLocale(ModSettings settings)
        {
            Entries = LoadSettingsLocale(settings);
        }

        public IEnumerable<KeyValuePair<string, string>> ReadEntries(
            IList<IDictionaryEntryError> errors,
            Dictionary<string, int> indexCounts
        ) => Entries;

        public void Unload()
        {
        }

        private static Dictionary<string, string> LoadSettingsLocale(ModSettings settings)
        {
            return new Dictionary<string, string>
            {
                // =========================
                // DisableHover - main mod UI
                // =========================

                { settings.GetSettingsLocaleID(), "DisableHover" },
                { settings.GetOptionGroupLocaleID(ModSettings.MainGroup), "DisableHover" },

                // =========================
                // DisableHover - tooltips
                // =========================

                { settings.GetOptionLabelLocaleID(nameof(ModSettings.DisableUIToolTips)), "Disable Tooltips" },
                { settings.GetOptionDescLocaleID(nameof(ModSettings.DisableUIToolTips)), "Disables annoying and distracting UI tooltips." },

                // =========================
                // Blue Highlights - settings
                // =========================

                { settings.GetOptionLabelLocaleID(nameof(ModSettings.DisableAllBlueHighlights)), "Disable All Blue Highlights" },
                { settings.GetOptionDescLocaleID(nameof(ModSettings.DisableAllBlueHighlights)), "Disables all blue hover highlights." },

                { settings.GetOptionLabelLocaleID(nameof(ModSettings.DisableBlueHighlightsOnBuildings)), "Disable Blue Highlights on Buildings" },
                { settings.GetOptionDescLocaleID(nameof(ModSettings.DisableBlueHighlightsOnBuildings)), "Disables blue hover highlights on buildings." },

                { settings.GetOptionLabelLocaleID(nameof(ModSettings.DisableBlueHighlightsOnRoads)), "Disable Blue Highlights on Roads" },
                { settings.GetOptionDescLocaleID(nameof(ModSettings.DisableBlueHighlightsOnRoads)), "Disables blue hover highlights on roads." },

                { settings.GetOptionLabelLocaleID(nameof(ModSettings.DisableBlueHighlightsOnTrees)), "Disable Blue Highlights on Trees" },
                { settings.GetOptionDescLocaleID(nameof(ModSettings.DisableBlueHighlightsOnTrees)), "Disables blue hover highlights on trees." },
            };
        }
    }
}