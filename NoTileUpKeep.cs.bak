using HarmonyLib;
using Game.Simulation;

namespace NoTileUpkeep
{
    [HarmonyPatch(typeof(MapTilePurchaseSystem), nameof(MapTilePurchaseSystem.GetMapTileUpkeepCostMultiplier))]
