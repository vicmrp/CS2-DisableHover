using HarmonyLib;
using Game.Tools;
using Game.Common;
using Game.Buildings;
using Game.Objects;
using Unity.Entities;
using System.Reflection;

namespace DisableHover.Patches
{
    [HarmonyPatch(typeof(ToolRaycastSystem), nameof(ToolRaycastSystem.GetRaycastResult))]
    public static class ToolRaycastPatch
    {
        static void Postfix(ref bool __result, ref RaycastResult result)
        {
            if (!Mod.DisableBlueHighlight)
                return;

            if (!__result)
                return;

            EntityManager em = World.DefaultGameObjectInjectionWorld.EntityManager;

            Entity ownerEntity = result.m_Owner;
            Entity hitEntity = result.m_Hit.m_HitEntity;

            Mod.log.Info($"[Hover] Owner entity: {ownerEntity}");
            Mod.log.Info($"[Hover] Hit entity: {hitEntity}");

            LogEntityCheck(em, ownerEntity, "Owner");
            LogEntityCheck(em, hitEntity, "Hit");

            if (IsBuildingOrOwnedByBuilding(em, ownerEntity))
            {
                Mod.log.Info($"[Hover] Building detected through Owner: {ownerEntity}");
            }
            else if (IsBuildingOrOwnedByBuilding(em, hitEntity))
            {
                Mod.log.Info($"[Hover] Building detected through Hit: {hitEntity}");
            }
            else
            {
                Mod.log.Info("[Hover] Not a building");
            }

            // IMPORTANT:
            // Do NOT do this here:
            //
            // __result = false;
            // result = default;
            //
            // That breaks clicking/opening the building info panel.
        }

        private static bool IsBuildingOrOwnedByBuilding(EntityManager em, Entity entity)
        {
            if (entity == Entity.Null)
                return false;

            if (!em.Exists(entity))
                return false;

            if (em.HasComponent<Building>(entity))
                return true;

            if (em.HasComponent<Owner>(entity))
            {
                Entity owner = em.GetComponentData<Owner>(entity).m_Owner;

                if (owner != Entity.Null &&
                    em.Exists(owner) &&
                    em.HasComponent<Building>(owner))
                {
                    return true;
                }
            }

            return false;
        }

        private static void LogEntityCheck(EntityManager em, Entity entity, string label)
        {
            Mod.log.Info($"[Check:{label}] Entity: {entity}");

            if (entity == Entity.Null)
            {
                Mod.log.Info($"[Check:{label}] Entity is null");
                return;
            }

            if (!em.Exists(entity))
            {
                Mod.log.Info($"[Check:{label}] Entity does not exist");
                return;
            }

            bool hasBuilding = em.HasComponent<Building>(entity);
            bool hasOwner = em.HasComponent<Owner>(entity);

            Mod.log.Info($"[Check:{label}] Has Building: {hasBuilding}");
            Mod.log.Info($"[Check:{label}] Has Owner: {hasOwner}");

            if (hasOwner)
            {
                Entity owner = em.GetComponentData<Owner>(entity).m_Owner;

                Mod.log.Info($"[Check:{label}] Owner: {owner}");

                if (owner != Entity.Null && em.Exists(owner))
                {
                    Mod.log.Info($"[Check:{label}] Owner has Building: {em.HasComponent<Building>(owner)}");
                }
            }
        }

        private static void DumpRaycastResult(RaycastResult result)
        {
            foreach (FieldInfo field in typeof(RaycastResult).GetFields(
                BindingFlags.Instance |
                BindingFlags.Public |
                BindingFlags.NonPublic))
            {
                object value = field.GetValue(result);
                Mod.log.Info($"[RaycastResult] {field.Name} = {value}");
            }
        }
    }
}