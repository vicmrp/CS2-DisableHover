using Game.Input;
using Game.Tools;
using HarmonyLib;

namespace DisableHover.Patches.BlueHighLight
{
    /// <summary>
    /// DisableHover - click tracking.
    ///
    /// This patch remembers what entity was clicked.
    /// That allows the selected entity to keep its blue highlight,
    /// while normal hover highlights can still be blocked.
    /// </summary>
    [HarmonyPatch(typeof(DefaultToolSystem), "OnUpdate")]
    public static class DefaultToolClickPatch
    {
        static void Prefix(DefaultToolSystem __instance)
        {
            IProxyAction applyAction = ToolRaycastPatch.GetApplyAction(__instance);

            if (applyAction == null)
                return;

            if (applyAction.WasPressedThisFrame())
            {
                // =========================
                // Blue Highlights - selection tracking
                // =========================

                ToolRaycastPatch.SelectedEntity =
                    ToolRaycastPatch.LastHoverEntity;

                ToolRaycastPatch.SelectedBuildingEntity =
                    ToolRaycastPatch.LastBuildingEntity;

#if DEBUG
                Mod.log.Info(
                    $"[ClickDebug] Click detected. SelectedEntity={ToolRaycastPatch.SelectedEntity}, SelectedBuildingEntity={ToolRaycastPatch.SelectedBuildingEntity}"
                );
#endif
            }
        }
    }
}