using HarmonyLib;
using Game.Tools;
using Game.Common;
using Unity.Entities;
using Game.Buildings;

namespace DisableHover.Patches
{
    [HarmonyPatch(typeof(ToolRaycastSystem), nameof(ToolRaycastSystem.GetRaycastResult))]
    public static class ToolRaycastPatch
    {
        // ✅ ADD THIS HERE
        private static bool _logged = false;

        static void Postfix(ref bool __result, ref RaycastResult result)
        {
            // 🔍 DEBUG (runs once)
            if (!_logged)
            {
                Mod.log.Info("=== RaycastResult fields ===");

                foreach (var field in typeof(RaycastResult).GetFields())
                {
                    Mod.log.Info($"Field: {field.Name} ({field.FieldType})");

                    if (field.Name == "m_Hit")
                    {
                        Mod.log.Info("=== RaycastHit fields ===");

                        foreach (var sub in field.FieldType.GetFields())
                        {
                            Mod.log.Info($"  HitField: {sub.Name} ({sub.FieldType})");
                        }
                    }
                }

                _logged = true;
            }

            if (!Mod.DisableBlueHighlight)
                return;

            if (!__result)
                return;

            var hit = result.m_Hit;

            var entityField = hit.GetType().GetField("m_Entity")
                             ?? hit.GetType().GetField("m_Owner")
                             ?? hit.GetType().GetField("m_Target");

            if (entityField == null)
                return;

            var entity = (Entity)entityField.GetValue(hit);

            if (IsBuilding(entity))
            {
                __result = false;
                result = default;
            }
        }

        private static bool IsBuilding(Entity entity)
        {
            if (entity == Entity.Null)
                return false;

            var em = World.DefaultGameObjectInjectionWorld.EntityManager;

            return em.HasComponent<Building>(entity);
        }
    }
}