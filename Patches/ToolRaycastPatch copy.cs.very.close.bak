using Game.Buildings;
using Game.Common;
using Game.Input;
using Game.Tools;
using HarmonyLib;
using System;
using System.Diagnostics;
using System.Reflection;
using Unity.Entities;

namespace DisableHover.Patches
{
    [HarmonyPatch(typeof(DefaultToolSystem), "OnUpdate")]
    public static class DefaultToolClickPatch
    {
        static void Prefix(DefaultToolSystem __instance)
        {
            IProxyAction applyAction = ToolRaycastPatch.GetApplyAction(__instance);

            if (applyAction == null)
                return;

            if (applyAction.WasPressedThisFrame())
            {
                ToolRaycastPatch.AllowBuildingRaycastFrames = 8;

                Mod.log.Info(
                    $"[ClickDebug] DefaultToolSystem applyAction pressed. AllowBuildingRaycastFrames={ToolRaycastPatch.AllowBuildingRaycastFrames}"
                );
            }
        }
    }

    [HarmonyPatch(typeof(ToolRaycastSystem), nameof(ToolRaycastSystem.GetRaycastResult))]
    public static class ToolRaycastPatch
    {
        public static bool IsHoveringBuilding = false;
        public static Entity LastOwnerEntity = Entity.Null;
        public static Entity LastHitEntity = Entity.Null;
        public static Entity LastBuildingEntity = Entity.Null;

        public static int AllowBuildingRaycastFrames = 0;

        private static int _logCounter = 0;

        static void Postfix(ref bool __result, ref RaycastResult result)
        {
            IsHoveringBuilding = false;
            LastOwnerEntity = Entity.Null;
            LastHitEntity = Entity.Null;
            LastBuildingEntity = Entity.Null;

            if (!Mod.DisableBlueHighlight || !__result)
                return;

            EntityManager em = World.DefaultGameObjectInjectionWorld.EntityManager;

            LastOwnerEntity = result.m_Owner;
            LastHitEntity = result.m_Hit.m_HitEntity;

            Entity ownerBuilding = ResolveBuilding(em, LastOwnerEntity);
            Entity hitBuilding = ResolveBuilding(em, LastHitEntity);

            LastBuildingEntity = ownerBuilding != Entity.Null
                ? ownerBuilding
                : hitBuilding;

            IsHoveringBuilding = LastBuildingEntity != Entity.Null;

            if (!IsHoveringBuilding)
                return;

            bool fromDefaultTool = CalledFrom("Game.Tools.DefaultToolSystem");
            bool fromNameTooltip = CalledFrom("Game.UI.Tooltip.RaycastNameTooltipSystem");

            if (_logCounter++ % 60 == 0)
            {
                Mod.log.Info(
                    $"[HoverBlockDebug] Building={LastBuildingEntity}, AllowFrames={AllowBuildingRaycastFrames}, FromDefaultTool={fromDefaultTool}, FromNameTooltip={fromNameTooltip}"
                );

                DumpCallStack();
            }

            if (AllowBuildingRaycastFrames > 0)
            {
                AllowBuildingRaycastFrames--;

                Mod.log.Info(
                    $"[HoverBlock] ALLOW because click was detected. FramesLeft={AllowBuildingRaycastFrames}, Building={LastBuildingEntity}"
                );

                return;
            }

            Mod.log.Info(
                $"[HoverBlock] BLOCK building hover raycast. Owner={LastOwnerEntity}, Hit={LastHitEntity}, Building={LastBuildingEntity}"
            );

            __result = false;
            result = default;
        }

        public static Entity ResolveBuilding(EntityManager em, Entity entity)
        {
            if (entity == Entity.Null || !em.Exists(entity))
                return Entity.Null;

            if (em.HasComponent<Building>(entity))
                return entity;

            if (em.HasComponent<Owner>(entity))
            {
                Entity owner = em.GetComponentData<Owner>(entity).m_Owner;

                if (owner != Entity.Null &&
                    em.Exists(owner) &&
                    em.HasComponent<Building>(owner))
                {
                    return owner;
                }
            }

            return Entity.Null;
        }

        public static IProxyAction GetApplyAction(ToolBaseSystem tool)
        {
            try
            {
                PropertyInfo property = AccessTools.Property(typeof(ToolBaseSystem), "applyAction");

                if (property == null)
                {
                    Mod.log.Info("[ClickDebug] Could not find ToolBaseSystem.applyAction property");
                    return null;
                }

                return property.GetValue(tool) as IProxyAction;
            }
            catch (Exception ex)
            {
                Mod.log.Info($"[ClickDebug] GetApplyAction failed: {ex.Message}");
                return null;
            }
        }

        private static bool CalledFrom(string fullTypeName)
        {
            StackTrace stackTrace = new StackTrace();

            for (int i = 0; i < stackTrace.FrameCount; i++)
            {
                string typeName = stackTrace.GetFrame(i)?
                    .GetMethod()?
                    .DeclaringType?
                    .FullName;

                if (typeName == fullTypeName)
                    return true;
            }

            return false;
        }

        private static void DumpCallStack()
        {
            StackTrace stackTrace = new StackTrace();

            Mod.log.Info("===== RAYCAST CALL STACK START =====");

            for (int i = 0; i < stackTrace.FrameCount; i++)
            {
                MethodBase method = stackTrace.GetFrame(i)?.GetMethod();

                if (method == null)
                    continue;

                string typeName = method.DeclaringType?.FullName ?? "<null>";
                string methodName = method.Name;

                Mod.log.Info($"[Stack] {i}: {typeName}.{methodName}");
            }

            Mod.log.Info("===== RAYCAST CALL STACK END =====");
        }
    }
}