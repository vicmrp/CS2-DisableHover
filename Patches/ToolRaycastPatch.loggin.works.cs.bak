using HarmonyLib;
using Game.Tools;
using Game.Common;
using Game.Buildings;
using Unity.Entities;
using System.Reflection;

namespace DisableHover.Patches
{
    [HarmonyPatch(typeof(ToolRaycastSystem), nameof(ToolRaycastSystem.GetRaycastResult))]
    public static class ToolRaycastPatch
    {
        static void Postfix(ToolRaycastSystem __instance, ref bool __result, ref RaycastResult result)
        {
            if (!Mod.DisableBlueHighlight)
                return;

            if (!__result)
                return;

            Entity hitEntity = GetHitEntity(result);

            if (hitEntity == Entity.Null)
                return;

            EntityManager em = World.DefaultGameObjectInjectionWorld.EntityManager;

            Mod.log.Info($"Hovered entity: {hitEntity}");

            // Main building check
            if (em.HasComponent<Building>(hitEntity))
            {
                Mod.log.Info($"Blocking building hover: {hitEntity}");
                __result = false;
                result = default;
                return;
            }

            // Optional: if sub-objects/parts point to a parent entity,
            // you may need to inspect Owner/Prefab/Attached/etc depending on result.
        }

        private static Entity GetHitEntity(RaycastResult result)
        {
            // RaycastResult usually contains an internal RaycastHit field.
            var resultType = typeof(RaycastResult);

            foreach (var field in resultType.GetFields(BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic))
            {
                object value = field.GetValue(result);

                if (value is Entity entity)
                    return entity;

                if (value == null)
                    continue;

                var valueType = value.GetType();

                foreach (var subField in valueType.GetFields(BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic))
                {
                    object subValue = subField.GetValue(value);

                    if (subValue is Entity subEntity)
                    {
                        Mod.log.Info($"Found entity via {field.Name}.{subField.Name}: {subEntity}");
                        return subEntity;
                    }
                }
            }

            return Entity.Null;
        }




    }
}